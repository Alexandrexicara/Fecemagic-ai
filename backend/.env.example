# Desenvolvimento local. Nunca coloque segredos reais no Git.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
MAX_UPLOAD_MB=12
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/DB?sslmode=require
JWT_SECRET=gere-uma-chave-aleatoria-longa-com-pelo-menos-32-caracteres
JWT_EXPIRE_HOURS=24
ADMIN_API_KEY=gere-ou-use-um-segredo-administrativo-longo
FACE_SWAP_ENGINE=disabled

# Chave privada da API FazeSwap (somente no backend/Render).
FAZESWAP_API_KEY=cole_sua_chave_privada_aqui
